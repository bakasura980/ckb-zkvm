# CKB Network Configuration
# -------------------------
# CKB Testnet RPC endpoint
CKB_RPC_URL=https://testnet.ckb.dev/rpc

# RPC request timeout in seconds
CKB_RPC_TIMEOUT=30

# Maximum retry attempts for RPC calls
CKB_RPC_MAX_RETRIES=3

# SP1 Configuration
# -----------------
# Prover mode: "local" only for POC (no network prover)
SP1_PROVER=local

# Enable execution report (optional, for debugging)
# SP1_EXECUTION_REPORT=1

# Output Configuration
# --------------------
# Directory for proof artifacts
OUTPUT_DIR=./output

# Logging Configuration
# ---------------------
# Log level: trace, debug, info, warn, error
RUST_LOG=info
